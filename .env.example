# Local only — Vercel ignores PORT and assigns its own.
PORT=5000

# MongoDB Atlas connection string, including the database name.
# Atlas > Network Access must allow 0.0.0.0/0 for Vercel's rotating IPs.
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Signing key for the auth JWTs. Any long random string.
JWT_SECRET=replace-me-with-a-long-random-string

# Frontend origin(s) allowed by CORS. Comma-separated; unset means allow all.
CLIENT_URL=https://your-frontend.vercel.app
